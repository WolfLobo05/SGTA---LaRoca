<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="429.0" prefWidth="760.0"
            styleClass="ventana"
            stylesheets="@categorias.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.CategoriaController">

    <!-- Barra de título -->
    <AnchorPane layoutX="1.0" layoutY="1.0"
                prefHeight="31.0" prefWidth="758.0"
                styleClass="barra-titulo">

        <Label layoutX="12.0" layoutY="8.0"
               text="Sistema abarrotes &quot;La roca&quot; — Gestión de Categorías"
               styleClass="titulo"/>

        <HBox layoutX="704.0" layoutY="10.5" spacing="4.0">
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
        </HBox>
    </AnchorPane>

    <!-- Barra de herramientas -->
    <AnchorPane layoutX="1.0" layoutY="32.0"
                prefHeight="49.0" prefWidth="758.0"
                styleClass="barra-herramientas">

        <Button fx:id="btnNuevo" layoutX="16.0" layoutY="10.0"
                text="Nuevo" onAction="#nuevo"
                styleClass="boton-principal"/>

        <Button fx:id="btnEliminar" layoutX="89.0" layoutY="10.0"
                text="Eliminar" onAction="#eliminar"
                styleClass="boton-eliminar" disable="true"/>

        <Button text="Volver al menú"
                onAction="#volverAlMenu"
                layoutX="176.0"
                layoutY="10.0"
                styleClass="boton-secundario"/>

        <Label fx:id="lblFecha"
               layoutX="677.0" layoutY="17.0"
               styleClass="fecha"/>
    </AnchorPane>

    <!-- Tabla de categorías -->
    <TableView fx:id="tablaCategorias"
               layoutX="17.0" layoutY="97.0"
               prefHeight="298.0" prefWidth="395.0"
               styleClass="tabla">

        <columns>
            <TableColumn fx:id="columnaNombre"
             text="Nombre de la categoría"
             prefWidth="115.0"/>

            <TableColumn fx:id="columnaDescripcion"
             text="Descripción"
             prefWidth="145.0"/>

            <TableColumn fx:id="columnaEstado"
             text="Estado" prefWidth="85.0"/>
        </columns>
    </TableView>

    <!-- Formulario de detalle -->
    <AnchorPane layoutX="428.0" layoutY="97.0"
                prefHeight="298.0" prefWidth="315.0"
                styleClass="panel-detalle">

        <Label layoutX="17.0" layoutY="17.0"
               text="Detalle" styleClass="titulo-detalle"/>

        <Label layoutX="17.0" layoutY="44.0"
               text="Nombre de la categoría"
               styleClass="etiqueta"/>

        <TextField fx:id="txtNombre"
                   layoutX="16.0" layoutY="65.0"
                   prefHeight="33.0" prefWidth="281.0"
                   promptText="Nombre de la categoría"/>

        <Label layoutX="17.0" layoutY="105.0"
               text="Descripción" styleClass="etiqueta"/>

        <TextField fx:id="txtDescripcion"
                   layoutX="16.0" layoutY="126.0"
                   prefHeight="33.0" prefWidth="281.0"
                   promptText="Descripción de la categoría"/>

        <Label layoutX="17.0" layoutY="166.0"
               text="Estado" styleClass="etiqueta"/>

        <ComboBox fx:id="cmbEstado"
                  layoutX="16.0" layoutY="186.0"
                  prefHeight="30.0" prefWidth="281.0"
                  promptText="Selecciona un estado"/>

        <Button fx:id="btnGuardar"
                layoutX="17.0" layoutY="249.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Guardar" onAction="#guardar"
                styleClass="boton-principal" disable="true"/>

        <Button fx:id="btnCancelar"
                layoutX="161.0" layoutY="249.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Cancelar" onAction="#cancelar"
                styleClass="boton-secundario" disable="true"/>
    </AnchorPane>

    <!-- Barra inferior -->
    <AnchorPane layoutX="1.0" layoutY="404.0"
                prefHeight="24.0" prefWidth="758.0"
                styleClass="pie">

        <Label fx:id="lblTotalCategorias"
               layoutX="20.0" layoutY="6.0"
               text="0 categorías registradas"
               styleClass="texto-pie"/>
    </AnchorPane>

</AnchorPane>
