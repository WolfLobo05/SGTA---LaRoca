<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla CRUD estándar: 900x600, mismo diseño en los 7 módulos. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.CategoriaController">

    <top>
        <VBox>
            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La Roca" — Gestión de Categorías'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>

            <!-- BARRA DE HERRAMIENTAS -->
            <HBox styleClass="barra-herramientas">
                <Button fx:id="btnNuevo" text="Nuevo"
                        onAction="#nuevo"
                        styleClass="boton-principal"/>

                <Button fx:id="btnEliminar" text="Eliminar"
                        onAction="#eliminar"
                        styleClass="boton-eliminar"
                        disable="true"/>

                <Button text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <CheckBox fx:id="chkMostrarInactivos"
                          text="Mostrar inactivos"
                          onAction="#cambiarMostrarInactivos"
                          styleClass="check-inactivos"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFecha" styleClass="fecha"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox styleClass="contenido">
            <!-- TABLA: una columna por campo del Detalle, Estado al final.
                 Si no caben, la tabla se desplaza en horizontal. -->
            <TableView fx:id="tablaCategorias"
                       HBox.hgrow="ALWAYS"
                       styleClass="tabla">
                <columns>
                    <TableColumn fx:id="columnaNombre" text="Nombre de la categoría"
                                 minWidth="140.0" prefWidth="170.0"/>
                    <TableColumn fx:id="columnaDescripcion" text="Descripción"
                                 minWidth="150.0" prefWidth="230.0"/>
                    <TableColumn fx:id="columnaEstado" text="Estado"
                                 minWidth="70.0" prefWidth="80.0"/>
                </columns>
            </TableView>

            <!-- PANEL DE DETALLE: mismo tamaño en todas las pantallas -->
            <VBox styleClass="panel-detalle"
                  minWidth="320.0" prefWidth="320.0" maxWidth="320.0">

                <Label text="Detalle" styleClass="titulo-detalle"/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS"
                            styleClass="scroll-detalle">
                    <VBox styleClass="formulario">
                        <VBox styleClass="campo">
                            <Label text="Nombre de la categoría" styleClass="etiqueta"/>
                            <TextField fx:id="txtNombre" maxWidth="Infinity"
                                       promptText="Nombre de la categoría"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Descripción" styleClass="etiqueta"/>
                            <TextField fx:id="txtDescripcion" maxWidth="Infinity"
                                       promptText="Descripción de la categoría"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Estado" styleClass="etiqueta"/>
                            <!-- El estado solo se muestra; no se edita -->
                            <TextField fx:id="txtEstado" maxWidth="Infinity"
                                       editable="false" disable="true"
                                       focusTraversable="false"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- Fuera del desplazamiento: siempre visibles -->
                <HBox styleClass="acciones-detalle">
                    <Button fx:id="btnGuardar" text="Guardar"
                            onAction="#guardar"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="boton-principal"
                            disable="true"/>

                    <Button fx:id="btnCancelar" text="Cancelar"
                            onAction="#cancelar"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="boton-secundario"
                            disable="true"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <!-- BARRA INFERIOR -->
        <HBox styleClass="pie">
            <Label fx:id="lblTotalCategorias" text="0 categorías activas" styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
