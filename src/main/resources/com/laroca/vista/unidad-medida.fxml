<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefWidth="760.0"
    prefHeight="429.0"
    minWidth="760.0"
    minHeight="429.0"
    maxWidth="760.0"
    maxHeight="429.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.laroca.controlador.UnidadMedidaController"
    stylesheets="@unidad-medida.css"
    styleClass="root">

    <!-- ENCABEZADO -->
    <top>
        <VBox>

            <!-- BARRA DE TITULO -->
            <AnchorPane
                prefWidth="760.0"
                prefHeight="31.0"
                styleClass="encabezado">

                <Label
                    layoutX="12.0"
                    layoutY="8.0"
                    text="Sistema abarrotes &quot;La Roca&quot; — Gestión de Unidades de Medida"
                    styleClass="titulo"/>

                <!-- TRES CUADROS DECORATIVOS -->
                <HBox
                    layoutX="704.0"
                    layoutY="10.5"
                    spacing="4.0">

                    <Region
                        layoutX="0.0"
                        prefWidth="10.0"
                        prefHeight="10.0"
                        styleClass="boton-ventana"/>

                    <Region
                        prefWidth="10.0"
                        prefHeight="10.0"
                        styleClass="boton-ventana"/>

                    <Region
                        prefWidth="10.0"
                        prefHeight="10.0"
                        styleClass="boton-ventana"/>

                </HBox>
            </AnchorPane>

            <!-- BARRA DE BOTONES -->
            <HBox
                spacing="10.0"
                styleClass="barra-botones"
                alignment="CENTER_LEFT">

                <Button
                    fx:id="btnNuevo"
                    text="Nuevo"
                    onAction="#nuevo"
                    styleClass="btn-principal"/>

                <Button
                    fx:id="btnEliminar"
                    text="Eliminar"
                    onAction="#eliminar"
                    styleClass="btn-eliminar"
                    disable="true"/>

                <Button
                    text="Volver al menú"
                    onAction="#volverAlMenu"
                    styleClass="btn-secundario"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                    fx:id="lblFecha"
                    styleClass="fecha"/>

            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <HBox
            spacing="18.0"
            styleClass="contenido">

            <!-- TABLA DE UNIDADES -->
            <VBox
                spacing="8.0"
                HBox.hgrow="ALWAYS"
                styleClass="panel">

                <Label
                    text="Unidades registradas"
                    styleClass="subtitulo"/>

                <TableView
                    fx:id="tablaUnidades"
                    VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn
                            fx:id="columnaId"
                            text="ID"
                            prefWidth="70.0"/>

                        <TableColumn
                            fx:id="columnaNombre"
                            text="Nombre"
                            prefWidth="180.0"/>

                        <TableColumn
                            fx:id="columnaAbreviatura"
                            text="Abreviatura"
                            prefWidth="120.0"/>

                        <TableColumn
                            fx:id="columnaEstado"
                            text="Estado"
                            prefWidth="100.0"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- PANEL DE DETALLE -->
            <VBox
                spacing="15.0"
                prefWidth="320.0"
                minWidth="320.0"
                maxWidth="320.0"
                styleClass="panel detalle">

                <Label
                    text="Detalle"
                    styleClass="subtitulo"/>

                <VBox spacing="6.0">
                    <Label
                        text="Nombre de la unidad"
                        styleClass="etiqueta"/>

                    <TextField
                        fx:id="txtNombre"
                        promptText="Nombre de la unidad"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label
                        text="Abreviatura"
                        styleClass="etiqueta"/>

                    <TextField
                        fx:id="txtAbreviatura"
                        promptText="Abreviatura"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label
                        text="Estado"
                        styleClass="etiqueta"/>

                    <ComboBox
                        fx:id="cmbEstado"
                        promptText="Selecciona un estado"
                        maxWidth="Infinity"/>
                </VBox>

                <HBox
                    spacing="10.0"
                    alignment="CENTER_RIGHT">

                    <Button
                        fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardar"
                        styleClass="btn-guardar"
                        disable="true"/>

                    <Button
                        fx:id="btnCancelar"
                        text="Cancelar"
                        onAction="#cancelar"
                        styleClass="btn-cancelar"
                        disable="true"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <!-- PIE -->
    <bottom>
        <HBox
            styleClass="pie"
            alignment="CENTER_LEFT">

            <Label
                fx:id="lblRegistros"
                text="0 unidades registradas"/>
        </HBox>
    </bottom>

</BorderPane>