<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelReporte"
            prefWidth="1100.0"
            prefHeight="720.0"
            minWidth="900.0"
            minHeight="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.ReporteInventarioController"
            style="-fx-background-color: #eeeeee;">

    <!-- ENCABEZADO Y FILTROS -->
    <top>
        <VBox spacing="12"
              style="-fx-background-color: #292929;">

            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>

            <Label text="Sistema Abarrotes &quot;La Roca&quot; — Reporte de Inventario"
                   style="-fx-text-fill: white;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <VBox spacing="4">
                    <Label text="Categoría"
                           style="-fx-text-fill: white;"/>
                    <ComboBox fx:id="cmbCategoria"
                              prefWidth="145"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Desde"
                           style="-fx-text-fill: white;"/>
                    <DatePicker fx:id="dpDesde"
                                prefWidth="135"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Hasta"
                           style="-fx-text-fill: white;"/>
                    <DatePicker fx:id="dpHasta"
                                prefWidth="135"/>
                </VBox>

                <Button text="Generar reporte"
                        onAction="#generarReporte"
                        style="-fx-background-color: #287a55;
                               -fx-text-fill: white;"/>

                <Button text="Actualizar"
                        onAction="#actualizarReporte"/>

                <Button text="Imprimir / PDF"
                        onAction="#imprimirReporte"/>

                <Button text="Exportar Excel"
                        onAction="#exportarExcel"/>

                <Button text="Volver"
                        onAction="#volverAlMenu"/>

            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <!-- TITULO -->
            <VBox spacing="5">

                <Label text="LA ROCA — REPORTE DE INVENTARIO"
                       style="-fx-font-size: 21px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #292929;"/>

                <Label text="Detalle de existencias, movimientos y valor del inventario"
                       style="-fx-text-fill: #666666;"/>

            </VBox>

            <!-- TARJETAS DE RESUMEN -->
            <HBox spacing="12">

                <VBox spacing="6"
                      prefWidth="250"
                      style="-fx-background-color: white;
                             -fx-border-color: #cccccc;
                             -fx-padding: 12;">

                    <Label text="Productos"/>

                    <Label fx:id="lblProductos"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      prefWidth="250"
                      style="-fx-background-color: white;
                             -fx-border-color: #cccccc;
                             -fx-padding: 12;">

                    <Label text="Unidades en existencia"/>

                    <Label fx:id="lblExistencias"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      prefWidth="250"
                      style="-fx-background-color: white;
                             -fx-border-color: #cccccc;
                             -fx-padding: 12;">

                    <Label text="Valor del inventario"/>

                    <Label fx:id="lblValor"
                           text="$0.00"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      prefWidth="250"
                      style="-fx-background-color: white;
                             -fx-border-color: #cccccc;
                             -fx-padding: 12;">

                    <Label text="Productos por reordenar"/>

                    <Label fx:id="lblReorden"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #c0392b;"/>

                </VBox>

            </HBox>

            <!-- TABLA DE INVENTARIO -->
            <TableView fx:id="tablaReporte"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colProducto"
                                 text="Producto"
                                 prefWidth="145"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colUnidad"
                                 text="Unidad"
                                 prefWidth="65"/>

                    <TableColumn fx:id="colEntradas"
                                 text="Entradas"
                                 prefWidth="75"/>

                    <TableColumn fx:id="colSalidas"
                                 text="Salidas"
                                 prefWidth="75"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="65"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colValor"
                                 text="Valor"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colReorden"
                                 text="Punto de reorden"
                                 prefWidth="115"/>

                </columns>

            </TableView>

            <Label text="Entradas = compras · Salidas = ventas + mermas · Stock = existencia registrada"
                   style="-fx-text-fill: #666666;
                          -fx-font-size: 11px;"/>

        </VBox>
    </center>

    <!-- PIE DE PANTALLA -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #dddddd;
                     -fx-padding: 10;">

            <Label fx:id="lblEstado"
                   text="Esperando generación del reporte..."
                   style="-fx-text-fill: #555555;"/>

        </HBox>
    </bottom>

</BorderPane>
