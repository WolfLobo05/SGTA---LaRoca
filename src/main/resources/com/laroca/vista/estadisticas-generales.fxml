<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1180.0" prefHeight="740.0"
            style="-fx-background-color: #ECECEC;"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.EstadisticasGeneralesController">

    <top>
        <VBox>
            <HBox style="-fx-background-color: linear-gradient(to bottom, #3A3A3A 0%, #1F1F1F 100%); -fx-padding: 8 15; -fx-alignment: CENTER_LEFT;">
                <Label text="Sistema abarrotes &quot;La roca&quot; — Estadísticas"
                       style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-family: 'Inter'; -fx-font-weight: 600;" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="5" alignment="CENTER">
                    <Pane prefWidth="9.0" prefHeight="9.0" style="-fx-background-color: #5A5A5A; -fx-background-radius: 2;" />
                    <Pane prefWidth="9.0" prefHeight="9.0" style="-fx-background-color: #5A5A5A; -fx-background-radius: 2;" />
                    <Pane prefWidth="9.0" prefHeight="9.0" style="-fx-background-color: #5A5A5A; -fx-background-radius: 2;" />
                </HBox>
            </HBox>

            <HBox spacing="12.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: #DCDCDC; -fx-padding: 12 15; -fx-border-color: #B5B5B5; -fx-border-width: 0 0 1 0;">

                <VBox spacing="2.0">
                    <Label text="Periodo" />
                    <ComboBox fx:id="cmbPeriodo" prefWidth="160.0" prefHeight="28.0"
                              promptText="Seleccionar periodo" />
                </VBox>

                <VBox spacing="2.0">
                    <Label text="Desde" />
                    <TextField fx:id="txtDesde" prefWidth="100.0"
                               prefHeight="28.0" text="2026-09-01" />
                </VBox>

                <VBox spacing="2.0">
                    <Label text="Hasta" />
                    <TextField fx:id="txtHasta" prefWidth="100.0"
                               prefHeight="28.0" text="2026-09-22" />
                </VBox>

                <VBox spacing="2.0">
                    <Label text="Categoría" />
                    <ComboBox fx:id="cmbCategoria" prefWidth="140.0"
                              prefHeight="28.0" promptText="Todas" />
                </VBox>

                <Button fx:id="btnGenerar" text="Generar estadísticas"
                        onAction="#handleGenerar" prefHeight="28.0"
                        style="-fx-background-color: #2E6EA6; -fx-text-fill: white;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnVolver" text="Volver"
                        onAction="#volverAlMenu" prefHeight="28.0" prefWidth="75.0" />

                <Button fx:id="btnActualizar" text="Actualizar"
                        onAction="#handleActualizar" prefHeight="28.0" prefWidth="85.0" />

                <Button fx:id="btnExportar" text="Exportar"
                        onAction="#handleExportar" prefHeight="28.0" prefWidth="75.0" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="scroll-pane"
                    style="-fx-background: #ECECEC; -fx-padding: 12;">
            <VBox spacing="12.0" style="-fx-background-color: #ECECEC;">

                <HBox spacing="10.0">
                    <VBox HBox.hgrow="ALWAYS" prefHeight="80.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 10 12; -fx-border-color: #B5B5B5;">
                        <Label text="Ventas del periodo" />
                        <Label fx:id="lblVentasPeriodo" text="0.00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Total de ventas" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefHeight="80.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 10 12; -fx-border-color: #B5B5B5;">
                        <Label text="Número de ventas" />
                        <Label fx:id="lblNumVentas" text="0"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="tickets" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefHeight="80.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 10 12; -fx-border-color: #B5B5B5;">
                        <Label text="Ticket promedio" />
                        <Label fx:id="lblTicketPromedio" text="0.00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Promedio por venta" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefHeight="80.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 10 12; -fx-border-color: #B5B5B5;">
                        <Label text="Compras del periodo" />
                        <Label fx:id="lblComprasPeriodo" text="0.00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label fx:id="lblSubCompras" text="0 compras" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefHeight="80.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 10 12; -fx-border-color: #B5B5B5;">
                        <Label text="Mermas del periodo" />
                        <Label fx:id="lblMermasPeriodo" text="0.00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Importe registrado" />
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" prefWidth="640.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #B5B5B5;">
                        <Label text="Ventas por día" />
                        <BarChart fx:id="graficoVentasDia" legendVisible="false"
                                  prefHeight="210.0">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox prefWidth="430.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #B5B5B5;">
                        <Label text="Productos más vendidos" />
                        <TableView fx:id="tablaTopProductos" prefHeight="170.0">
                            <columns>
                                <TableColumn fx:id="colTopNombre" text="Producto" prefWidth="295.0" />
                                <TableColumn fx:id="colTopCantidad" text="Unidades" prefWidth="105.0" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" prefWidth="350.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #B5B5B5;">
                        <Label text="Ventas por categoría" />
                        <TableView fx:id="tablaCategoria" prefHeight="170.0">
                            <columns>
                                <TableColumn fx:id="colCatNombre" text="Categoría" prefWidth="210.0" />
                                <TableColumn fx:id="colCatTotal" text="Importe" prefWidth="120.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefWidth="330.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #B5B5B5;">
                        <Label text="Método de pago" />
                        <TableView fx:id="tablaMetodoPago" prefHeight="170.0">
                            <columns>
                                <TableColumn fx:id="colMetodoNombre" text="Método" prefWidth="175.0" />
                                <TableColumn fx:id="colMetodoTotal" text="Importe" prefWidth="130.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" prefWidth="360.0" spacing="4.0"
                          style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #B5B5B5;">
                        <Label text="Productos con stock bajo" />
                        <TableView fx:id="tablaStockBajo" prefHeight="170.0">
                            <columns>
                                <TableColumn fx:id="colStockProd" text="Producto" prefWidth="140.0" />
                                <TableColumn fx:id="colStockActual" text="Stock" prefWidth="55.0" />
                                <TableColumn fx:id="colStockMinimo" text="Mínimo" prefWidth="60.0" />
                                <TableColumn fx:id="colStockEstado" text="Estado" prefWidth="85.0" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
