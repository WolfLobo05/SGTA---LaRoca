<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Estadísticas generales. Misma ventana de 900x600 y mismas barras
     que el Reporte de Inventario: herramientas, filtros y estado. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.EstadisticasGeneralesController">

    <top>
        <VBox>
            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La roca" — Estadísticas'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>

            <!-- BARRA DE HERRAMIENTAS -->
            <HBox styleClass="barra-herramientas">
                <Button fx:id="btnGenerar" text="Generar estadísticas"
                        onAction="#handleGenerar"
                        styleClass="boton-principal"/>

                <Button fx:id="btnActualizar" text="Actualizar"
                        onAction="#handleActualizar"
                        styleClass="boton-secundario"/>

                <Button fx:id="btnExportar" text="Exportar"
                        onAction="#handleExportar"
                        styleClass="boton-secundario"/>

                <Button fx:id="btnVolver" text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFecha" styleClass="fecha"/>
            </HBox>

            <!-- BARRA DE FILTROS -->
            <HBox styleClass="barra-filtros">
                <VBox styleClass="filtro">
                    <Label text="Periodo" styleClass="etiqueta-filtro"/>
                    <ComboBox fx:id="cmbPeriodo" prefWidth="170.0"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Desde" styleClass="etiqueta-filtro"/>
                    <DatePicker fx:id="dpDesde" prefWidth="120.0" promptText="dd/mm/aaaa"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Hasta" styleClass="etiqueta-filtro"/>
                    <DatePicker fx:id="dpHasta" prefWidth="120.0" promptText="dd/mm/aaaa"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Categoría" styleClass="etiqueta-filtro"/>
                    <ComboBox fx:id="cmbCategoria" prefWidth="170.0"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="fondo-desplazable">
            <VBox styleClass="contenido-estadisticas">

                <!-- TARJETAS -->
                <HBox styleClass="fila-tarjetas">
                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Ventas del periodo" styleClass="tarjeta-titulo"/>
                        <Label fx:id="lblVentasPeriodo" text="\$0.00" styleClass="tarjeta-valor"/>
                        <Label fx:id="lblSubVentas" text="0 días con ventas" styleClass="tarjeta-subtitulo"/>
                    </VBox>
                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Número de ventas" styleClass="tarjeta-titulo"/>
                        <Label fx:id="lblNumVentas" text="0" styleClass="tarjeta-valor"/>
                        <Label text="tickets" styleClass="tarjeta-subtitulo"/>
                    </VBox>
                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Ticket promedio" styleClass="tarjeta-titulo"/>
                        <Label fx:id="lblTicketPromedio" text="\$0.00" styleClass="tarjeta-valor"/>
                        <Label text="por venta" styleClass="tarjeta-subtitulo"/>
                    </VBox>
                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Compras del periodo" styleClass="tarjeta-titulo"/>
                        <Label fx:id="lblComprasPeriodo" text="\$0.00" styleClass="tarjeta-valor"/>
                        <Label fx:id="lblSubCompras" text="0 compras" styleClass="tarjeta-subtitulo"/>
                    </VBox>
                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Mermas del periodo" styleClass="tarjeta-titulo"/>
                        <Label fx:id="lblMermasPeriodo" text="\$0.00" styleClass="tarjeta-valor"/>
                        <Label fx:id="lblSubMermas" text="— de ventas" styleClass="tarjeta-subtitulo"/>
                    </VBox>
                </HBox>

                <!-- GRÁFICA + PRODUCTOS MÁS VENDIDOS -->
                <HBox styleClass="fila-paneles">
                    <VBox styleClass="panel-seccion" HBox.hgrow="ALWAYS" prefWidth="500.0">
                        <Label text="Ventas por día" styleClass="titulo-seccion"/>
                        <Label fx:id="lblSubGrafico" text="Sin ventas en el periodo"
                               styleClass="subtitulo-seccion"/>
                        <BarChart fx:id="graficoVentasDia" legendVisible="false"
                                  animated="false" prefHeight="210.0"
                                  styleClass="grafico-ventas">
                            <xAxis><CategoryAxis side="BOTTOM" animated="false"/></xAxis>
                            <yAxis><NumberAxis side="LEFT" animated="false"/></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox styleClass="panel-seccion" prefWidth="320.0" minWidth="320.0">
                        <Label text="Productos más vendidos" styleClass="titulo-seccion"/>
                        <Label text="Unidades vendidas en el periodo" styleClass="subtitulo-seccion"/>
                        <TableView fx:id="tablaTopProductos" prefHeight="210.0"
                                   styleClass="tabla, tabla-chica">
                            <columns>
                                <TableColumn fx:id="colTopNombre" text="Producto" prefWidth="205.0"/>
                                <TableColumn fx:id="colTopCantidad" text="Unidades" prefWidth="65.0"
                                             styleClass="columna-numero"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- TRES TABLAS -->
                <HBox styleClass="fila-paneles">
                    <VBox styleClass="panel-seccion" HBox.hgrow="ALWAYS" prefWidth="260.0">
                        <Label text="Ventas por categoría" styleClass="titulo-seccion"/>
                        <Label text="Importe vendido en el periodo" styleClass="subtitulo-seccion"/>
                        <TableView fx:id="tablaCategoria" prefHeight="170.0"
                                   styleClass="tabla, tabla-chica">
                            <columns>
                                <TableColumn fx:id="colCatNombre" text="Categoría" prefWidth="135.0"/>
                                <TableColumn fx:id="colCatTotal" text="Importe" prefWidth="85.0"
                                             styleClass="columna-numero"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox styleClass="panel-seccion" HBox.hgrow="ALWAYS" prefWidth="240.0">
                        <Label text="Método de pago" styleClass="titulo-seccion"/>
                        <Label text="Importe vendido en el periodo" styleClass="subtitulo-seccion"/>
                        <TableView fx:id="tablaMetodoPago" prefHeight="170.0"
                                   styleClass="tabla, tabla-chica">
                            <columns>
                                <TableColumn fx:id="colMetodoNombre" text="Método" prefWidth="115.0"/>
                                <TableColumn fx:id="colMetodoTotal" text="Importe" prefWidth="85.0"
                                             styleClass="columna-numero"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox styleClass="panel-seccion" HBox.hgrow="ALWAYS" prefWidth="300.0">
                        <Label text="Productos a reordenar" styleClass="titulo-seccion"/>
                        <Label text="Existencia actual contra punto de reorden" styleClass="subtitulo-seccion"/>
                        <TableView fx:id="tablaStockBajo" prefHeight="170.0"
                                   styleClass="tabla, tabla-chica">
                            <columns>
                                <TableColumn fx:id="colStockProd" text="Producto" prefWidth="110.0"/>
                                <TableColumn fx:id="colStockActual" text="Stock" prefWidth="45.0"
                                             styleClass="columna-numero"/>
                                <TableColumn fx:id="colStockMinimo" text="Reorden" prefWidth="55.0"
                                             styleClass="columna-numero"/>
                                <TableColumn fx:id="colStockEstado" text="Estado" prefWidth="62.0"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <!-- BARRA DE ESTADO -->
        <HBox styleClass="pie">
            <Label fx:id="lblEstado" text="Genera las estadísticas para ver el periodo."
                   styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
