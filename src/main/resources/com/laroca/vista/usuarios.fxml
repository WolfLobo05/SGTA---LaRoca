<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="763.0" prefWidth="760.0"
            styleClass="ventana"
            stylesheets="@usuarios.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.UsuarioController">

    <!-- BARRA DE TITULO -->
    <AnchorPane layoutX="1.0" layoutY="1.0"
                prefHeight="31.0" prefWidth="758.0"
                styleClass="barra-titulo">

        <Label layoutX="12.0" layoutY="8.0"
               text="Sistema abarrotes &quot;La Roca&quot; — Gestión de Usuarios"
               styleClass="titulo"/>

        <HBox layoutX="704.0" layoutY="10.5" spacing="4.0">
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
        </HBox>
    </AnchorPane>

    <!-- BARRA DE HERRAMIENTAS -->
    <AnchorPane layoutX="1.0" layoutY="32.0"
                prefHeight="49.0" prefWidth="758.0"
                styleClass="barra-herramientas">

        <Button fx:id="btnNuevo"
                layoutX="16.0" layoutY="10.0"
                text="Nuevo" onAction="#nuevo"
                styleClass="boton-principal"/>

        <Button fx:id="btnEliminar"
                layoutX="89.0" layoutY="10.0"
                text="Eliminar" onAction="#eliminar"
                styleClass="boton-eliminar"
                disable="true"/>

        <Button layoutX="176.0" layoutY="10.0"
                text="Volver al menú"
                onAction="#volverAlMenu"
                styleClass="boton-secundario"/>

        <Label fx:id="lblFecha"
               layoutX="677.0" layoutY="17.0"
               styleClass="fecha"/>
    </AnchorPane>

    <!-- TABLA DE USUARIOS -->
    <TableView fx:id="tablaUsuarios"
               layoutX="17.0" layoutY="97.0"
               prefHeight="624.0" prefWidth="395.0"
               styleClass="tabla">

        <columns>
            <TableColumn fx:id="columnaId"
                         text="ID" prefWidth="35.0"/>

            <TableColumn fx:id="columnaUsuario"
                         text="Usuario"
                         prefWidth="65.0"/>

            <TableColumn fx:id="columnaNombreCompleto"
                         text="Nombre completo"
                         prefWidth="100.0"/>

            <TableColumn fx:id="columnaRol"
                         text="Rol"
                         prefWidth="55.0"/>

            <TableColumn fx:id="columnaTelefono"
                         text="Teléfono"
                         prefWidth="65.0"/>

            <TableColumn fx:id="columnaCorreo"
                         text="Correo"
                         prefWidth="60.0"/>
        </columns>
    </TableView>

    <!-- PANEL DE DETALLE -->
    <AnchorPane layoutX="428.0" layoutY="97.0"
                prefHeight="624.0" prefWidth="315.0"
                styleClass="panel-detalle">

        <Label layoutX="17.0" layoutY="14.0"
               text="Detalle"
               styleClass="titulo-detalle"/>

        <Label layoutX="17.0" layoutY="42.0"
               text="Usuario"
               styleClass="etiqueta"/>

        <TextField fx:id="txtUsuario"
                   layoutX="16.0" layoutY="62.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Nombre de usuario"/>

        <Label layoutX="17.0" layoutY="107.0"
               text="Contraseña"
               styleClass="etiqueta"/>

        <PasswordField fx:id="txtPassword"
                       layoutX="16.0" layoutY="127.0"
                       prefHeight="32.0" prefWidth="281.0"
                       promptText="Contraseña"/>

        <Label layoutX="17.0" layoutY="172.0"
               text="Nombre"
               styleClass="etiqueta"/>

        <TextField fx:id="txtNombre"
                   layoutX="16.0" layoutY="192.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Nombre"/>

        <Label layoutX="17.0" layoutY="237.0"
               text="Apellido paterno"
               styleClass="etiqueta"/>

        <TextField fx:id="txtApellidoPaterno"
                   layoutX="16.0" layoutY="257.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Apellido paterno"/>

        <Label layoutX="17.0" layoutY="302.0"
               text="Apellido materno"
               styleClass="etiqueta"/>

        <TextField fx:id="txtApellidoMaterno"
                   layoutX="16.0" layoutY="322.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Apellido materno"/>

        <Label layoutX="17.0" layoutY="367.0"
               text="Teléfono"
               styleClass="etiqueta"/>

        <TextField fx:id="txtTelefono"
                   layoutX="16.0" layoutY="387.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="10 dígitos"/>

        <Label layoutX="17.0" layoutY="432.0"
               text="Correo"
               styleClass="etiqueta"/>

        <TextField fx:id="txtCorreo"
                   layoutX="16.0" layoutY="452.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="correo@ejemplo.com"/>

        <Label layoutX="17.0" layoutY="497.0"
               text="Rol"
               styleClass="etiqueta"/>

        <ComboBox fx:id="cmbRol"
                  layoutX="16.0" layoutY="517.0"
                  prefHeight="32.0" prefWidth="281.0"
                  promptText="Selecciona un rol"/>

        <Button fx:id="btnGuardar"
                layoutX="17.0" layoutY="576.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Guardar"
                onAction="#guardar"
                styleClass="boton-principal"
                disable="true"/>

        <Button fx:id="btnCancelar"
                layoutX="161.0" layoutY="576.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Cancelar"
                onAction="#cancelar"
                styleClass="boton-secundario"
                disable="true"/>
    </AnchorPane>

    <!-- BARRA INFERIOR -->
    <AnchorPane layoutX="1.0" layoutY="738.0"
                prefHeight="24.0" prefWidth="758.0"
                styleClass="pie">

        <Label fx:id="lblRegistros"
               layoutX="12.0" layoutY="6.0"
               text="0 usuarios registrados"
               styleClass="texto-pie"/>
    </AnchorPane>

</AnchorPane>
