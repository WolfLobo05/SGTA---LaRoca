<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="429.0" prefWidth="760.0"
            styleClass="ventana"
            stylesheets="@roles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.RolController">

    <!-- BARRA DE TITULO -->
    <AnchorPane layoutX="1.0" layoutY="1.0"
                prefHeight="31.0" prefWidth="758.0"
                styleClass="barra-titulo">

        <Label layoutX="12.0" layoutY="8.0"
               text="Sistema abarrotes &quot;La Roca&quot; — Gestión de Roles"
               styleClass="titulo"/>

        <HBox layoutX="704.0" layoutY="10.5" spacing="4.0">
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
        </HBox>
    </AnchorPane>

    <!-- BARRA DE HERRAMIENTAS -->
    <AnchorPane layoutX="1.0" layoutY="32.0"
                prefHeight="49.0" prefWidth="758.0"
                styleClass="barra-herramientas">

        <Button fx:id="btnNuevo"
                layoutX="16.0" layoutY="10.0"
                text="Nuevo" onAction="#nuevo"
                styleClass="boton-principal"/>

        <Button fx:id="btnEliminar"
                layoutX="89.0" layoutY="10.0"
                text="Eliminar" onAction="#eliminar"
                styleClass="boton-eliminar"
                disable="true"/>

        <Button layoutX="176.0" layoutY="10.0"
                text="Volver al menú"
                onAction="#volverAlMenu"
                styleClass="boton-secundario"/>

        <Label fx:id="lblFecha"
               layoutX="677.0" layoutY="17.0"
               styleClass="fecha"/>
    </AnchorPane>

    <!-- TABLA DE ROLES -->
    <TableView fx:id="tablaRoles"
               layoutX="17.0" layoutY="97.0"
               prefHeight="298.0" prefWidth="395.0"
               styleClass="tabla">

        <columns>
            <TableColumn fx:id="columnaNombre"
                         text="Nombre del rol"
                         prefWidth="110.0"/>

            <TableColumn fx:id="columnaDescripcion"
                         text="Descripción"
                         prefWidth="150.0"/>

            <TableColumn fx:id="columnaEstado"
                         text="Estado"
                         prefWidth="85.0"/>
        </columns>
    </TableView>

    <!-- PANEL DE DETALLE -->
    <AnchorPane layoutX="428.0" layoutY="97.0"
                prefHeight="298.0" prefWidth="315.0"
                styleClass="panel-detalle">

        <Label layoutX="17.0" layoutY="14.0"
               text="Detalle"
               styleClass="titulo-detalle"/>

        <Label layoutX="17.0" layoutY="42.0"
               text="Nombre del rol"
               styleClass="etiqueta"/>

        <TextField fx:id="txtNombre"
                   layoutX="16.0" layoutY="62.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Nombre del rol"/>

        <Label layoutX="17.0" layoutY="101.0"
               text="Descripción"
               styleClass="etiqueta"/>

        <TextField fx:id="txtDescripcion"
                   layoutX="16.0" layoutY="121.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Descripción del rol"/>

        <Label layoutX="17.0" layoutY="160.0"
               text="Estado"
               styleClass="etiqueta"/>

        <ComboBox fx:id="cmbEstado"
                  layoutX="16.0" layoutY="180.0"
                  prefHeight="30.0" prefWidth="281.0"
                  promptText="Selecciona un estado"/>

        <Button fx:id="btnGuardar"
                layoutX="17.0" layoutY="249.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Guardar"
                onAction="#guardar"
                styleClass="boton-principal"
                disable="true"/>

        <Button fx:id="btnCancelar"
                layoutX="161.0" layoutY="249.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Cancelar"
                onAction="#cancelar"
                styleClass="boton-secundario"
                disable="true"/>
    </AnchorPane>

    <!-- BARRA INFERIOR -->
    <AnchorPane layoutX="1.0" layoutY="404.0"
                prefHeight="24.0" prefWidth="758.0"
                styleClass="pie">

        <Label fx:id="lblRegistros"
               layoutX="12.0" layoutY="6.0"
               text="0 roles registrados"
               styleClass="texto-pie"/>
    </AnchorPane>

</AnchorPane>
