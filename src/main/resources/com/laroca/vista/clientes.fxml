<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="850.0"
            stylesheets="@clientes.css"
            style="-fx-background-color: #ECECEC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.ClienteController">

    <children>

        <!-- Barra superior -->
        <HBox alignment="CENTER_LEFT"
              prefHeight="31.0"
              style="-fx-background-color: #2A2A2A; -fx-padding: 0 10px;"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Sistema abarrotes &quot;La roca&quot; — Gestión de Clientes"
                       textFill="#F0F0F0">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
            </children>
        </HBox>

        <!-- Barra de herramientas -->
        <HBox alignment="CENTER_LEFT"
              layoutY="31.0"
              spacing="10.0"
              style="-fx-background-color: #DCDCDC; -fx-padding: 10;"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <Button fx:id="btnNuevo"
                        onAction="#nuevoCliente"
                        mnemonicParsing="false"
                        style="-fx-background-color: #2F6FA8; -fx-text-fill: white;"
                        text="Nuevo"/>

                <Button fx:id="btnEliminar"
                        disable="true"
                        onAction="#eliminarCliente"
                        mnemonicParsing="false"
                        style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C; -fx-text-fill: #A83A3A;"
                        text="Eliminar"/>

                <Button fx:id="btnVolverMenu"
                        onAction="#volverAlMenu"
                        mnemonicParsing="false"
                        style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C;"
                        text="Volver al Menú"/>

                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblFechaActual"
                               text="--/--/----"
                               textFill="#333333"/>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Tabla de clientes: ID oculto desde el controlador -->
        <TableView fx:id="tableClientes"
                   layoutX="14.0"
                   layoutY="85.0"
                   prefHeight="375.0"
                   prefWidth="430.0"
                   AnchorPane.bottomAnchor="30.0"
                   AnchorPane.leftAnchor="15.0"
                   AnchorPane.topAnchor="85.0">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40.0"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100.0"/>
                <TableColumn fx:id="colApellidoPaterno" text="Apellido Paterno" prefWidth="125.0"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110.0"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="150.0"/>
            </columns>
        </TableView>

        <!-- Panel de detalle -->
        <AnchorPane layoutX="460.0"
                    layoutY="85.0"
                    prefHeight="375.0"
                    prefWidth="375.0"
                    style="-fx-background-color: #F5F5F5; -fx-border-color: #B5B5B5;"
                    AnchorPane.bottomAnchor="30.0"
                    AnchorPane.rightAnchor="15.0"
                    AnchorPane.topAnchor="85.0">
            <children>

                <Label layoutX="15.0" layoutY="12.0"
                       text="Detalle" textFill="#5C5C5C">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>

                <Label layoutX="15.0" layoutY="35.0"
                       text="Nombre" textFill="#5C5C5C"/>
                <TextField fx:id="txtNombre"
                           layoutX="15.0" layoutY="52.0"
                           prefHeight="26.0" prefWidth="345.0"
                           promptText="Nombre del cliente"/>

                <Label layoutX="15.0" layoutY="83.0"
                       text="Apellido paterno" textFill="#5C5C5C"/>
                <TextField fx:id="txtApellidoPaterno"
                           layoutX="15.0" layoutY="100.0"
                           prefHeight="26.0" prefWidth="345.0"
                           promptText="Apellido paterno"/>

                <Label layoutX="15.0" layoutY="131.0"
                       text="Apellido materno" textFill="#5C5C5C"/>
                <TextField fx:id="txtApellidoMaterno"
                           layoutX="15.0" layoutY="148.0"
                           prefHeight="26.0" prefWidth="345.0"
                           promptText="Apellido materno (opcional)"/>

                <Label layoutX="15.0" layoutY="179.0"
                       text="Teléfono" textFill="#5C5C5C"/>
                <TextField fx:id="txtTelefono"
                           layoutX="15.0" layoutY="196.0"
                           prefHeight="26.0" prefWidth="345.0"
                           promptText="10 dígitos (opcional)"/>

                <Label layoutX="15.0" layoutY="227.0"
                       text="Correo" textFill="#5C5C5C"/>
                <TextField fx:id="txtCorreo"
                           layoutX="15.0" layoutY="244.0"
                           prefHeight="26.0" prefWidth="345.0"
                           promptText="cliente@correo.com"/>

                <!-- Guardar y cancelar -->
                <Button fx:id="btnGuardar"
                        layoutX="15.0" layoutY="310.0"
                        onAction="#guardarCliente"
                        mnemonicParsing="false"
                        prefHeight="30.0" prefWidth="165.0"
                        style="-fx-background-color: #2F6FA8; -fx-text-fill: white;"
                        text="Guardar"/>

                <Button fx:id="btnCancelar"
                        layoutX="195.0" layoutY="310.0"
                        onAction="#cancelarAccion"
                        mnemonicParsing="false"
                        prefHeight="30.0" prefWidth="165.0"
                        style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C;"
                        text="Cancelar"/>

            </children>
        </AnchorPane>

        <!-- Pie de página -->
        <HBox alignment="CENTER_LEFT"
              prefHeight="25.0"
              style="-fx-background-color: #DCDCDC; -fx-border-color: #B5B5B5 transparent transparent transparent; -fx-padding: 0 10px;"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <Label fx:id="lblEstadoFooter"
                       text="Gestión de clientes activa"
                       textFill="#5C5C5C">
                    <font>
                        <Font size="10.0"/>
                    </font>
                </Label>
            </children>
        </HBox>

    </children>
</AnchorPane>
