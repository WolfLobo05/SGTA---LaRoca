<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.RegistrarMermaController">

    <top>
        <VBox>
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La Roca" — Registrar Merma'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>
            <HBox styleClass="barra-herramientas">
                <Button text="Registrar merma" styleClass="boton-principal" disable="true"/>
                <Button fx:id="btnCancelarMerma" text="Cancelar merma"
                        onAction="#cancelarMerma" styleClass="boton-eliminar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Folio:" styleClass="fecha"/>
                <Label fx:id="lblFolio" styleClass="fecha, folio"/>
                <Label fx:id="lblFechaMerma" styleClass="fecha"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox styleClass="contenido" spacing="10.0">
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <VBox styleClass="panel-detalle" spacing="8.0">
                    <Label text="Agregar producto a la merma" styleClass="titulo-detalle"/>
                    <HBox spacing="8.0" alignment="BOTTOM_LEFT" styleClass="formulario-compacto">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Código de barras / Producto" styleClass="etiqueta"/>
                            <TextField fx:id="txtCodigo" promptText="Escanea o escribe el código"/>
                        </VBox>
                        <VBox styleClass="campo" minWidth="64.0" prefWidth="64.0" maxWidth="64.0">
                            <Label text="Cantidad" styleClass="etiqueta"/>
                            <TextField fx:id="txtCantidad" text="1" onAction="#agregarProducto"/>
                        </VBox>
                        <Button fx:id="btnBuscar" text="Buscar" onAction="#buscarProducto"
                                prefHeight="30.0" styleClass="boton-secundario"/>
                    </HBox>
                    <HBox spacing="8.0" alignment="BOTTOM_LEFT" styleClass="formulario-compacto">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Motivo de la merma (por producto)" styleClass="etiqueta"/>
                            <TextField fx:id="txtMotivo" promptText="Ej. Producto caducado, roto, derramado..."
                                       onAction="#agregarProducto"/>
                        </VBox>
                        <Button fx:id="btnAgregar" text="Agregar" onAction="#agregarProducto"
                                prefHeight="30.0" styleClass="boton-principal"/>
                    </HBox>
                </VBox>

                <TableView fx:id="tableCarrito" VBox.vgrow="ALWAYS" styleClass="tabla">
                    <columns>
                        <TableColumn fx:id="colNumero" text="#" minWidth="28.0" prefWidth="30.0" sortable="false"/>
                        <TableColumn fx:id="colProducto" text="Producto" minWidth="100.0" prefWidth="145.0" sortable="false"/>
                        <TableColumn fx:id="colCantidad" text="Cant." minWidth="48.0" prefWidth="52.0" sortable="false"/>
                        <TableColumn fx:id="colPrecio" text="Costo unit." minWidth="72.0" prefWidth="78.0" sortable="false"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal" minWidth="72.0" prefWidth="78.0" sortable="false"/>
                        <TableColumn fx:id="colMotivo" text="Motivo" minWidth="90.0" prefWidth="120.0" sortable="false"/>
                        <TableColumn fx:id="colQuitar" text="" minWidth="30.0" prefWidth="32.0" sortable="false" resizable="false"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="lblStock" styleClass="texto-stock"/>
                </HBox>
            </VBox>

            <VBox styleClass="panel-detalle" minWidth="260.0" prefWidth="260.0" maxWidth="260.0">
                <Label text="Datos de la merma" styleClass="titulo-detalle"/>
                <VBox styleClass="formulario-compacto" VBox.vgrow="ALWAYS">
                    <VBox styleClass="campo">
                        <Label text="Empleado" styleClass="etiqueta"/>
                        <TextField fx:id="txtEmpleado" editable="false" focusTraversable="false" styleClass="campo-lectura"/>
                    </VBox>
                    <VBox styleClass="campo">
                        <Label text="Fecha" styleClass="etiqueta"/>
                        <TextField fx:id="txtFecha" editable="false" focusTraversable="false" styleClass="campo-lectura"/>
                    </VBox>
                    <HBox>
                        <Label text="Productos" styleClass="etiqueta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblNumProductos" text="0" styleClass="resumen-valor"/>
                    </HBox>
                    <HBox>
                        <Label text="Artículos" styleClass="etiqueta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblArticulos" text="0" styleClass="resumen-valor"/>
                    </HBox>
                    <VBox styleClass="campo">
                        <Label text="Costo total estimado" styleClass="etiqueta"/>
                        <Label fx:id="lblTotal" maxWidth="Infinity" styleClass="total-grande"/>
                    </VBox>
                </VBox>
                <HBox styleClass="acciones-detalle">
                    <Button fx:id="btnRegistrar" text="Registrar merma"
                            onAction="#registrarMerma" HBox.hgrow="ALWAYS"
                            maxWidth="Infinity" styleClass="boton-principal" disable="true"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="pie">
            <Label fx:id="lblEstadoFooter" text="0 productos en la merma" styleClass="texto-pie"/>
        </HBox>
    </bottom>
</BorderPane>
