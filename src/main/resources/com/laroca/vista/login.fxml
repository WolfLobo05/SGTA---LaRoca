<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<!-- Inicio de sesión: ventana chica (480x459), mismas clases de laroca.css. -->
<AnchorPane prefHeight="459.0" prefWidth="480.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.LoginController">
   <children>
      <!-- BARRA DE TÍTULO -->
      <HBox styleClass="barra-titulo"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Sistema abarrotes &quot;La Roca&quot; — Acceso" styleClass="titulo"/>
         </children>
      </HBox>

      <!-- Logo -->
      <StackPane layoutX="208.0" layoutY="68.0" prefHeight="64.0" prefWidth="64.0" styleClass="login-logo">
         <children>
            <Label text="A" styleClass="login-logo-texto"/>
         </children>
      </StackPane>

      <!-- Título y subtítulo -->
      <Label alignment="CENTER" layoutX="33.0" layoutY="138.0" prefWidth="414.0"
             text="Abarrotes La Roca" styleClass="login-titulo"/>
      <Label alignment="CENTER" layoutX="33.0" layoutY="161.0" prefWidth="414.0"
             text="Sistema de gestión de inventario" styleClass="login-subtitulo"/>

      <!-- Usuario -->
      <Label layoutX="33.0" layoutY="199.0" text="Usuario" styleClass="etiqueta"/>
      <TextField fx:id="txtUsuario" layoutX="33.0" layoutY="217.0" prefHeight="33.0" prefWidth="414.0"
                 promptText="Nombre de usuario" styleClass="campo-login"/>

      <!-- Contraseña -->
      <Label layoutX="33.0" layoutY="264.0" text="Contraseña" styleClass="etiqueta"/>
      <PasswordField fx:id="txtPassword" layoutX="33.0" layoutY="282.0" prefHeight="33.0" prefWidth="414.0"
                     promptText="••••••••" styleClass="campo-login"/>

      <!-- Recordar usuario y olvidó su contraseña -->
      <CheckBox fx:id="chkRecordar" layoutX="33.0" layoutY="330.0" mnemonicParsing="false"
                text="Recordar usuario" styleClass="texto-secundario"/>

      <Hyperlink fx:id="linkOlvidado" layoutX="315.0" layoutY="326.0" onAction="#olvidarPassword"
                 text="¿Olvidó su contraseña?" styleClass="enlace"/>

      <!-- Mensaje de error o aviso -->
      <Label fx:id="lblMensaje" alignment="CENTER" layoutX="33.0" layoutY="350.0" prefWidth="414.0"
             styleClass="mensaje-error"/>

      <!-- Iniciar sesión -->
      <Button fx:id="btnIngresar" layoutX="33.0" layoutY="370.0" mnemonicParsing="false" onAction="#ingresar"
              prefHeight="35.0" prefWidth="414.0" defaultButton="true"
              text="Iniciar sesión" styleClass="boton-principal, boton-ancho"/>

      <!-- BARRA INFERIOR -->
      <HBox styleClass="pie"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Label text="v1.0  •  Conectado a: localhost" styleClass="texto-pie"/>
         </children>
      </HBox>
   </children>
</AnchorPane>
