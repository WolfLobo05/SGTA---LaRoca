<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="459.0" prefWidth="480.0" style="-fx-background-color: #ECECEC; -fx-border-color: #8C8C8C;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laroca.controlador.LoginController">
   <children>
      <!-- Barra Superior -->
      <AnchorPane prefHeight="31.0" prefWidth="480.0" style="-fx-background-color: linear-gradient(to bottom, #3E3E3E, #2A2A2A);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label layoutX="12.0" layoutY="7.0" text="Sistema abarrotes &quot;La roca&quot; — Acceso" textFill="#F0F0F0">
               <font>
                  <Font name="System Bold" size="12.5" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Logo / Icono 'A' -->
      <AnchorPane layoutX="208.0" layoutY="68.0" prefHeight="64.0" prefWidth="64.0" style="-fx-background-color: #2F6FA8; -fx-border-color: #24567F;">
         <children>
            <Label alignment="CENTER" layoutX="0.0" layoutY="12.0" prefWidth="64.0" text="A" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Título y Subtítulo -->
      <Label alignment="CENTER" layoutX="33.0" layoutY="138.0" prefWidth="414.0" text="Abarrotes La Roca" textFill="#262626">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="33.0" layoutY="161.0" prefWidth="414.0" text="Sistema de gestión de inventario" textFill="#5C5C5C">
         <font>
            <Font size="10.5" />
         </font>
      </Label>

      <!-- Campo Usuario -->
      <Label layoutX="33.0" layoutY="199.0" text="Usuario" textFill="#5C5C5C">
         <font>
            <Font size="11.4" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" layoutX="33.0" layoutY="217.0" prefHeight="33.0" prefWidth="414.0" promptText="Nombre de usuario" style="-fx-background-color: WHITE; -fx-border-color: #B5B5B5; -fx-font-size: 12.3px;" />

      <!-- Campo Contraseña -->
      <Label layoutX="33.0" layoutY="264.0" text="Contraseña" textFill="#5C5C5C">
         <font>
            <Font size="11.3" />
         </font>
      </Label>
      <PasswordField fx:id="txtPassword" layoutX="33.0" layoutY="282.0" prefHeight="33.0" prefWidth="414.0" promptText="••••••••" style="-fx-background-color: WHITE; -fx-border-color: #B5B5B5; -fx-font-size: 11.1px;" />

      <!-- Recordar Usuario & Olvidó Contraseña -->
      <CheckBox fx:id="chkRecordar" layoutX="33.0" layoutY="330.0" mnemonicParsing="false" text="Recordar usuario" textFill="#5C5C5C">
         <font>
            <Font size="10.5" />
         </font>
      </CheckBox>

      <Hyperlink fx:id="linkOlvidado" layoutX="315.0" layoutY="326.0" onAction="#olvidarPassword" text="¿Olvidó su contraseña?" textFill="#5C5C5C" style="-fx-underline: false;">
         <font>
            <Font size="10.5" />
         </font>
      </Hyperlink>

      <!-- Mensaje de error o aviso -->
      <Label fx:id="lblMensaje" alignment="CENTER" layoutX="33.0" layoutY="350.0" prefWidth="414.0" textFill="#A83A3A">
         <font>
            <Font size="11.0" />
         </font>
      </Label>

      <!-- Botón Iniciar Sesión -->
      <Button fx:id="btnIngresar" layoutX="33.0" layoutY="370.0" mnemonicParsing="false" onAction="#ingresar" prefHeight="35.0" prefWidth="414.0" style="-fx-background-color: #2F6FA8; -fx-border-color: #24567F; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: bold;" text="Iniciar sesión" />

      <!-- Pie de página -->
      <HBox alignment="CENTER_LEFT" layoutY="433.0" prefHeight="25.0" prefWidth="480.0" style="-fx-background-color: #DCDCDC; -fx-border-color: #B5B5B5 transparent transparent transparent; -fx-padding: 0 12px;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Label text="v1.0  •  Conectado a: localhost" textFill="#5C5C5C">
               <font>
                  <Font size="10.3" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>