<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Mismo tamaño fijo que las pantallas CRUD (900x600).
     El contenido queda centrado, con espacio gris arriba y abajo. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            style="-fx-background-color: #ececec;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.MenuController">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="45.0" minHeight="45.0" maxHeight="45.0"
              style="-fx-background-color: linear-gradient(to bottom, #3e3e3e, #2a2a2a); -fx-padding: 0 20px;">
            <Label text="Sistema Abarrotes &quot;La Roca&quot;"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" alignment="CENTER">

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

            <Label text="Selecciona el módulo que deseas administrar"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;">
                <VBox.margin>
                    <Insets bottom="8.0"/>
                </VBox.margin>
            </Label>

            <!-- Dos columnas: catálogos a la izquierda, operaciones a la derecha -->
            <GridPane hgap="40.0" vgap="10.0" alignment="TOP_CENTER">
                <columnConstraints>
                    <ColumnConstraints prefWidth="300.0"/>
                    <ColumnConstraints prefWidth="300.0"/>
                </columnConstraints>

                <!-- CATÁLOGOS -->
                <Label text="Catálogos"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                <Button fx:id="btnUnidades"
                        text="Unidades de Medida"
                        onAction="#abrirUnidades"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button fx:id="btnCategorias"
                        text="Categorías de Productos"
                        onAction="#abrirCategorias"
                        GridPane.columnIndex="0" GridPane.rowIndex="2"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Roles"
                        onAction="#abrirRoles"
                        GridPane.columnIndex="0" GridPane.rowIndex="3"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Proveedores"
                        onAction="#abrirProveedores"
                        GridPane.columnIndex="0" GridPane.rowIndex="4"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Productos"
                        onAction="#abrirProductos"
                        GridPane.columnIndex="0" GridPane.rowIndex="5"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Usuarios"
                        onAction="#abrirUsuarios"
                        GridPane.columnIndex="0" GridPane.rowIndex="6"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Clientes"
                        onAction="#abrirClientes"
                        GridPane.columnIndex="0" GridPane.rowIndex="7"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <!-- OPERACIONES -->
                <Label text="Operaciones"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                <Button text="Ventas"
                        onAction="#abrirVentas"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Compras"
                        onAction="#abrirCompras"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>
                
                <Button text="Mermas"
                        onAction="#abrirMermas"
                        GridPane.columnIndex="1" GridPane.rowIndex="3"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Devoluciones de Clientes"
                        onAction="#abrirDevolucionesClientes"
                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Devoluciones a Proveedores"
                        onAction="#abrirDevolucionesProveedores"
                        GridPane.columnIndex="1" GridPane.rowIndex="5"
                        prefWidth="300.0" prefHeight="36.0"
                        style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>            
            </GridPane>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 20px 12px 20px;">
            <Label text="SGTA - La Roca"
                   style="-fx-text-fill: #777777; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
