<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Mismo tamaño fijo que las pantallas CRUD (900x600).
     El contenido queda centrado, con espacio gris arriba y abajo. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            style="-fx-background-color: #ececec;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.MenuController">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="45.0" minHeight="45.0" maxHeight="45.0"
              style="-fx-background-color: linear-gradient(to bottom, #3e3e3e, #2a2a2a); -fx-padding: 0 20px;">
            <Label text="Sistema Abarrotes &quot;La Roca&quot;"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" alignment="CENTER">

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

            <Label text="Selecciona el módulo que deseas administrar"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;">
                <VBox.margin>
                    <Insets bottom="8.0"/>
                </VBox.margin>
            </Label>

            <Button fx:id="btnUnidades"
                    text="Unidades de Medida"
                    onAction="#abrirUnidades"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button fx:id="btnCategorias"
                    text="Categorías de Productos"
                    onAction="#abrirCategorias"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button text="Roles"
                    onAction="#abrirRoles"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button text="Proveedores"
                    onAction="#abrirProveedores"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button text="Productos"
                    onAction="#abrirProductos"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button text="Usuarios"
                    onAction="#abrirUsuarios"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

            <Button text="Clientes"
                    onAction="#abrirClientes"
                    prefWidth="300.0" prefHeight="36.0"
                    style="-fx-background-color: #2f6fa8; -fx-text-fill: white; -fx-font-size: 14px;"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 20px 12px 20px;">
            <Label text="SGTA - La Roca"
                   style="-fx-text-fill: #777777; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
