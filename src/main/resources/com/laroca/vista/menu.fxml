<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Menú principal: misma ventana, barra de título y pie que el resto. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.MenuController">

    <top>
        <!-- BARRA DE TÍTULO -->
        <HBox styleClass="barra-titulo">
            <Label text='Sistema abarrotes "La Roca" — Menú Principal'
                   styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="botones-ventana">
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox styleClass="menu-contenido">

            <Label text="MENÚ PRINCIPAL" styleClass="menu-titulo"/>

            <Label text="Selecciona el módulo que deseas administrar"
                   styleClass="menu-subtitulo">
                <VBox.margin>
                    <Insets bottom="8.0"/>
                </VBox.margin>
            </Label>

            <!-- Dos columnas: catálogos a la izquierda, operaciones a la derecha -->
            <GridPane hgap="40.0" vgap="10.0" alignment="TOP_CENTER">
                <columnConstraints>
                    <ColumnConstraints prefWidth="300.0"/>
                    <ColumnConstraints prefWidth="300.0"/>
                </columnConstraints>

                <!-- CATÁLOGOS -->
                <Label text="Catálogos" styleClass="menu-seccion"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <Button fx:id="btnUnidades"
                        text="Unidades de Medida"
                        onAction="#abrirUnidades"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"
                        styleClass="boton-principal, boton-menu"/>
                <Button fx:id="btnCategorias"
                        text="Categorías de Productos"
                        onAction="#abrirCategorias"
                        GridPane.columnIndex="0" GridPane.rowIndex="2"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Roles"
                        onAction="#abrirRoles"
                        GridPane.columnIndex="0" GridPane.rowIndex="3"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Proveedores"
                        onAction="#abrirProveedores"
                        GridPane.columnIndex="0" GridPane.rowIndex="4"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Productos"
                        onAction="#abrirProductos"
                        GridPane.columnIndex="0" GridPane.rowIndex="5"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Usuarios"
                        onAction="#abrirUsuarios"
                        GridPane.columnIndex="0" GridPane.rowIndex="6"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Clientes"
                        onAction="#abrirClientes"
                        GridPane.columnIndex="0" GridPane.rowIndex="7"
                        styleClass="boton-principal, boton-menu"/>

                <!-- OPERACIONES Y REPORTES -->
                <Label text="Operaciones" styleClass="menu-seccion"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Button text="Ventas"
                        onAction="#abrirVentas"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Compras"
                        onAction="#abrirCompras"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Mermas"
                        onAction="#abrirMermas"
                        GridPane.columnIndex="1" GridPane.rowIndex="3"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Devoluciones de Clientes"
                        onAction="#abrirDevolucionesClientes"
                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Devoluciones a Proveedores"
                        onAction="#abrirDevolucionesProveedores"
                        GridPane.columnIndex="1" GridPane.rowIndex="5"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Reporte de Inventario"
                        onAction="#abrirEstadisticasStock"
                        GridPane.columnIndex="1" GridPane.rowIndex="6"
                        styleClass="boton-principal, boton-menu"/>
                <Button text="Estadísticas Generales"
                        onAction="#abrirEstadisticasGenerales"
                        GridPane.columnIndex="1" GridPane.rowIndex="7"
                        styleClass="boton-principal, boton-menu"/>
            </GridPane>

        </VBox>
    </center>

    <bottom>
        <!-- BARRA INFERIOR -->
        <HBox styleClass="pie">
            <Label text="SGTA - La Roca" styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
