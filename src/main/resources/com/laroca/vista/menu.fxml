<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.MenuController">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="barra-titulo">

            <Label text='Sistema abarrotes "La Roca" — Menú Principal'
                   styleClass="titulo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCerrarSesion"
                    text="Cerrar sesión"
                    onAction="#cerrarSesion"
                    mnemonicParsing="false"
                    prefHeight="28.0"
                    styleClass="boton-principal"/>

            <HBox styleClass="botones-ventana">
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="17.0"
              alignment="TOP_CENTER"
              style="-fx-background-color: #EEEEEE;">

            <padding>
                <Insets top="23" right="16" bottom="16" left="16"/>
            </padding>

            <!-- PRESENTACIÓN -->
            <VBox alignment="CENTER" spacing="5.0">
                <Label text="MENÚ PRINCIPAL"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                <Label text="Selecciona el módulo que deseas administrar"
                       style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
            </VBox>

            <!-- PANELES DE MÓDULOS -->
            <HBox spacing="12.0"
                  alignment="TOP_CENTER">

                <!-- CATÁLOGOS -->
                <VBox spacing="8.0"
                      prefWidth="265.0"
                      minWidth="0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0D0D0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 12;">

                    <Label text="CATÁLOGOS"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                    <Label text="Administración de registros"
                           style="-fx-font-size: 10px; -fx-text-fill: #777777;"/>

                    <Region prefHeight="1"
                            style="-fx-background-color: #337AB7;"/>

                    <Button fx:id="btnUnidades"
                            text="Unidades de Medida"
                            onAction="#abrirUnidades"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnCategorias"
                            text="Categorías de Productos"
                            onAction="#abrirCategorias"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnRoles"
                            text="Roles"
                            onAction="#abrirRoles"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnProveedores"
                            text="Proveedores"
                            onAction="#abrirProveedores"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnProductos"
                            text="Productos"
                            onAction="#abrirProductos"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnUsuarios"
                            text="Usuarios"
                            onAction="#abrirUsuarios"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnClientes"
                            text="Clientes"
                            onAction="#abrirClientes"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>
                </VBox>

                <!-- OPERACIONES -->
                <VBox spacing="8.0"
                      prefWidth="265.0"
                      minWidth="0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0D0D0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 12;">

                    <Label text="OPERACIONES"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                    <Label text="Movimientos del negocio"
                           style="-fx-font-size: 10px; -fx-text-fill: #777777;"/>

                    <Region prefHeight="1"
                            style="-fx-background-color: #337AB7;"/>

                    <Button fx:id="btnVentas"
                            text="Ventas"
                            onAction="#abrirVentas"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnCompras"
                            text="Compras"
                            onAction="#abrirCompras"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnMermas"
                            text="Mermas"
                            onAction="#abrirMermas"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnDevolucionesClientes"
                            text="Devoluciones de Clientes"
                            onAction="#abrirDevolucionesClientes"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnDevolucionesProveedores"
                            text="Devoluciones a Proveedores"
                            onAction="#abrirDevolucionesProveedores"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>
                </VBox>

                <!-- ESTADÍSTICAS -->
                <VBox spacing="8.0"
                      prefWidth="265.0"
                      minWidth="0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0D0D0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 12;">

                    <Label text="ESTADÍSTICAS"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                    <Label text="Consultas y reportes"
                           style="-fx-font-size: 10px; -fx-text-fill: #777777;"/>

                    <Region prefHeight="1"
                            style="-fx-background-color: #337AB7;"/>

                    <Button fx:id="btnEstadisticasGenerales"
                            text="Estadísticas Generales"
                            onAction="#abrirEstadisticasGenerales"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>

                    <Button fx:id="btnConsultarInventario"
                            text="Consultar Inventario"
                            onAction="#abrirEstadisticasStock"
                            maxWidth="Infinity"
                            prefHeight="34"
                            styleClass="boton-principal, boton-menu"/>
                </VBox>

            </HBox>
        </VBox>
    </center>

    <!-- PIE DE PÁGINA -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              styleClass="pie">

            <Label text="SGTA - La Roca"
                   styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
