<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- Menú principal. Los íconos y el contenido de las tarjetas se arman en
     MenuController; aquí quedan los botones, sus textos y sus acciones. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.MenuController">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="barra-titulo">

            <Label text='Sistema abarrotes "La Roca" — Menú Principal'
                   styleClass="titulo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox styleClass="botones-ventana">
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
                <Region styleClass="boton-ventana"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox styleClass="menu-contenido">

            <padding>
                <Insets top="18" right="24" bottom="16" left="24"/>
            </padding>

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label text="Menú principal" styleClass="menu-titulo"/>
                    <Label fx:id="lblSaludo" styleClass="menu-saludo"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnCerrarSesion"
                        text="Cerrar sesión"
                        onAction="#cerrarSesion"
                        mnemonicParsing="false"
                        styleClass="boton-secundario, boton-cerrar-sesion"/>
            </HBox>

            <!-- OPERACIONES DEL DÍA -->
            <Label text="OPERACIONES DEL DÍA" styleClass="menu-seccion"/>

            <GridPane hgap="12.0" vgap="12.0" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="50.0" vgrow="ALWAYS"/>
                    <RowConstraints percentHeight="50.0" vgrow="ALWAYS"/>
                </rowConstraints>

                <Button fx:id="btnVentas"
                        text="Ventas"
                        onAction="#abrirVentas"
                        mnemonicParsing="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"
                        GridPane.columnSpan="2" GridPane.rowSpan="2"
                        styleClass="tarjeta-menu, tarjeta-hero"/>

                <Button fx:id="btnCompras"
                        text="Compras"
                        onAction="#abrirCompras"
                        mnemonicParsing="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"
                        styleClass="tarjeta-menu"/>

                <Button fx:id="btnConsultarInventario"
                        text="Consultar Inventario"
                        onAction="#abrirEstadisticasStock"
                        mnemonicParsing="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        GridPane.columnIndex="3" GridPane.rowIndex="0"
                        styleClass="tarjeta-menu"/>

                <Button fx:id="btnMermas"
                        text="Mermas"
                        onAction="#abrirMermas"
                        mnemonicParsing="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        GridPane.columnIndex="2" GridPane.rowIndex="1"
                        styleClass="tarjeta-menu"/>

                <Button fx:id="btnEstadisticasGenerales"
                        text="Estadísticas"
                        onAction="#abrirEstadisticasGenerales"
                        mnemonicParsing="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        GridPane.columnIndex="3" GridPane.rowIndex="1"
                        styleClass="tarjeta-menu"/>
            </GridPane>

            <!-- DEVOLUCIONES -->
            <GridPane hgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>

                <Button fx:id="btnDevolucionesClientes"
                        text="Devoluciones de Clientes"
                        onAction="#abrirDevolucionesClientes"
                        mnemonicParsing="false"
                        maxWidth="Infinity"
                        GridPane.columnIndex="0"
                        styleClass="boton-operacion"/>

                <Button fx:id="btnDevolucionesProveedores"
                        text="Devoluciones a Proveedores"
                        onAction="#abrirDevolucionesProveedores"
                        mnemonicParsing="false"
                        maxWidth="Infinity"
                        GridPane.columnIndex="1"
                        styleClass="boton-operacion"/>
            </GridPane>

            <!-- CATÁLOGOS Y ADMINISTRACIÓN -->
            <VBox styleClass="menu-panel-catalogos">
                <Label text="CATÁLOGOS Y ADMINISTRACIÓN" styleClass="menu-seccion"/>

                <FlowPane hgap="8.0" vgap="8.0">
                    <Button fx:id="btnProductos" text="Productos"
                            onAction="#abrirProductos" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnClientes" text="Clientes"
                            onAction="#abrirClientes" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnProveedores" text="Proveedores"
                            onAction="#abrirProveedores" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnCategorias" text="Categorías"
                            onAction="#abrirCategorias" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnUnidades" text="Unidades de Medida"
                            onAction="#abrirUnidades" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnUsuarios" text="Usuarios"
                            onAction="#abrirUsuarios" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                    <Button fx:id="btnRoles" text="Roles"
                            onAction="#abrirRoles" mnemonicParsing="false"
                            styleClass="chip-menu"/>
                </FlowPane>
            </VBox>
        </VBox>
    </center>

    <!-- PIE DE PÁGINA -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              styleClass="pie">

            <Label text="SGTA - La Roca"
                   styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
