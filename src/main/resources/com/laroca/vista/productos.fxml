<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="635.0" prefWidth="760.0"
            styleClass="ventana"
            stylesheets="@productos.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.ProductoController">

    <!-- BARRA DE TITULO -->
    <AnchorPane layoutX="1.0" layoutY="1.0"
                prefHeight="31.0" prefWidth="758.0"
                styleClass="barra-titulo">

        <Label layoutX="12.0" layoutY="8.0"
               text="Sistema abarrotes &quot;La Roca&quot; — Gestión de Productos"
               styleClass="titulo"/>

        <HBox layoutX="704.0" layoutY="10.5" spacing="4.0">
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
            <Region prefHeight="10.0" prefWidth="10.0"
                    styleClass="boton-ventana"/>
        </HBox>
    </AnchorPane>

    <!-- BARRA DE HERRAMIENTAS -->
    <AnchorPane layoutX="1.0" layoutY="32.0"
                prefHeight="49.0" prefWidth="758.0"
                styleClass="barra-herramientas">

        <Button fx:id="btnNuevo"
                layoutX="16.0" layoutY="10.0"
                text="Nuevo" onAction="#nuevo"
                styleClass="boton-principal"/>

        <Button fx:id="btnEliminar"
                layoutX="89.0" layoutY="10.0"
                text="Eliminar" onAction="#eliminar"
                styleClass="boton-eliminar"
                disable="true"/>

        <Button layoutX="176.0" layoutY="10.0"
                text="Volver al menú"
                onAction="#volverAlMenu"
                styleClass="boton-secundario"/>

        <Label fx:id="lblFecha"
               layoutX="677.0" layoutY="17.0"
               styleClass="fecha"/>
    </AnchorPane>

    <!-- TABLA DE PRODUCTOS -->
    <TableView fx:id="tablaProductos"
               layoutX="17.0" layoutY="97.0"
               prefHeight="496.0" prefWidth="395.0"
               styleClass="tabla">

        <columns>
            <TableColumn fx:id="columnaCodigo"
                         text="Código de barras"
                         prefWidth="80.0"/>

            <TableColumn fx:id="columnaNombre"
                         text="Nombre"
                         prefWidth="90.0"/>

            <TableColumn fx:id="columnaCategoria"
                         text="Categoría"
                         prefWidth="65.0"/>

            <TableColumn fx:id="columnaUnidad"
                         text="Unidad"
                         prefWidth="55.0"/>

            <TableColumn fx:id="columnaPrecio"
                         text="Precio"
                         prefWidth="55.0"/>
        </columns>
    </TableView>

    <!-- PANEL DE DETALLE -->
    <AnchorPane layoutX="428.0" layoutY="97.0"
                prefHeight="496.0" prefWidth="315.0"
                styleClass="panel-detalle">

        <Label layoutX="17.0" layoutY="14.0"
               text="Detalle"
               styleClass="titulo-detalle"/>

        <Label layoutX="17.0" layoutY="42.0"
               text="Código de barras"
               styleClass="etiqueta"/>

        <TextField fx:id="txtCodigo"
                   layoutX="16.0" layoutY="62.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Código de barras"/>

        <Label layoutX="17.0" layoutY="107.0"
               text="Nombre del producto"
               styleClass="etiqueta"/>

        <TextField fx:id="txtNombre"
                   layoutX="16.0" layoutY="127.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="Nombre del producto"/>

        <Label layoutX="17.0" layoutY="172.0"
               text="Categoría"
               styleClass="etiqueta"/>

        <ComboBox fx:id="cmbCategoria"
                  layoutX="16.0" layoutY="192.0"
                  prefHeight="32.0" prefWidth="281.0"
                  promptText="Selecciona una categoría"/>

        <Label layoutX="17.0" layoutY="237.0"
               text="Unidad de medida"
               styleClass="etiqueta"/>

        <ComboBox fx:id="cmbUnidad"
                  layoutX="16.0" layoutY="257.0"
                  prefHeight="32.0" prefWidth="281.0"
                  promptText="Selecciona una unidad"/>

        <Label layoutX="17.0" layoutY="302.0"
               text="Precio"
               styleClass="etiqueta"/>

        <TextField fx:id="txtPrecio"
                   layoutX="16.0" layoutY="322.0"
                   prefHeight="32.0" prefWidth="281.0"
                   promptText="0.00"/>

        <Button fx:id="btnGuardar"
                layoutX="17.0" layoutY="448.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Guardar"
                onAction="#guardar"
                styleClass="boton-principal"
                disable="true"/>

        <Button fx:id="btnCancelar"
                layoutX="161.0" layoutY="448.0"
                prefHeight="32.0" prefWidth="136.0"
                text="Cancelar"
                onAction="#cancelar"
                styleClass="boton-secundario"
                disable="true"/>
    </AnchorPane>

    <!-- BARRA INFERIOR -->
    <AnchorPane layoutX="1.0" layoutY="610.0"
                prefHeight="24.0" prefWidth="758.0"
                styleClass="pie">

        <Label fx:id="lblRegistros"
               layoutX="12.0" layoutY="6.0"
               text="0 productos registrados"
               styleClass="texto-pie"/>
    </AnchorPane>

</AnchorPane>
