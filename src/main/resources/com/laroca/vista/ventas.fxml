<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Gestión de Ventas: misma estructura que las pantallas CRUD (900x600). -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.VentaController">

    <top>
        <VBox>
            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La Roca" — Gestión de Ventas'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>

            <!-- BARRA DE HERRAMIENTAS -->
            <HBox styleClass="barra-herramientas">
                <Button fx:id="btnNuevo" text="Nuevo"
                        onAction="#nuevaVenta"
                        styleClass="boton-principal"/>

                <Button fx:id="btnEditar" text="Editar"
                        onAction="#editarVenta"
                        styleClass="boton-secundario"
                        disable="true"/>

                <Button fx:id="btnEliminar" text="Eliminar"
                        onAction="#eliminarVenta"
                        styleClass="boton-eliminar"
                        disable="true"/>

                <Button fx:id="btnVolverMenu" text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <CheckBox fx:id="chkMostrarCanceladas"
                          text="Mostrar canceladas"
                          onAction="#cambiarMostrarCanceladas"
                          styleClass="check-inactivos"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFechaActual" styleClass="fecha"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox styleClass="contenido">
            <!-- TABLA DE VENTAS -->
            <TableView fx:id="tableVentas"
                       HBox.hgrow="ALWAYS"
                       styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colId" text="ID"
                                 minWidth="35.0" prefWidth="35.0"/>
                    <TableColumn fx:id="colFolio" text="Folio"
                                 minWidth="55.0" prefWidth="55.0"/>
                    <TableColumn fx:id="colEmpleado" text="Empleado"
                                 minWidth="90.0" prefWidth="105.0"/>
                    <TableColumn fx:id="colCliente" text="Cliente"
                                 minWidth="90.0" prefWidth="105.0"/>
                    <TableColumn fx:id="colMetodo" text="Método"
                                 minWidth="70.0" prefWidth="75.0"/>
                    <TableColumn fx:id="colFecha" text="Fecha"
                                 minWidth="70.0" prefWidth="72.0"/>
                    <TableColumn fx:id="colTotal" text="Total"
                                 minWidth="70.0" prefWidth="75.0"
                                 styleClass="columna-numero"/>
                </columns>
            </TableView>

            <!-- PANEL DE DETALLE: solo lectura -->
            <VBox styleClass="panel-detalle"
                  minWidth="320.0" prefWidth="320.0" maxWidth="320.0">

                <Label text="Detalle" styleClass="titulo-detalle"/>

                <VBox styleClass="formulario-compacto" VBox.vgrow="ALWAYS">
                    <HBox spacing="8.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="140.0">
                            <Label text="Folio" styleClass="etiqueta"/>
                            <TextField fx:id="txtFolio" editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="140.0">
                            <Label text="Fecha" styleClass="etiqueta"/>
                            <TextField fx:id="txtFecha" editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="8.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="140.0">
                            <Label text="Empleado" styleClass="etiqueta"/>
                            <TextField fx:id="txtEmpleado" editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="140.0">
                            <Label text="Cliente" styleClass="etiqueta"/>
                            <TextField fx:id="txtCliente" editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>
                            <!-- Solo visible al editar -->
                            <ComboBox fx:id="cmbCliente" maxWidth="Infinity"
                                      promptText="Selecciona un cliente"
                                      visible="false"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="campo">
                        <Label text="Método de pago" styleClass="etiqueta"/>
                        <TextField fx:id="txtMetodo" editable="false"
                                   focusTraversable="false"
                                   styleClass="campo-lectura"/>
                        <!-- Solo visible al editar -->
                        <ComboBox fx:id="cmbMetodo" maxWidth="Infinity"
                                  promptText="Selecciona un método"
                                  visible="false"/>
                    </VBox>

                    <VBox styleClass="campo" VBox.vgrow="ALWAYS">
                        <Label text="Productos" styleClass="etiqueta"/>
                        <TableView fx:id="tableDetalle"
                                   VBox.vgrow="ALWAYS"
                                   minHeight="70.0"
                                   focusTraversable="false"
                                   styleClass="tabla, tabla-chica">
                            <columns>
                                <TableColumn fx:id="colProducto" text="Producto"
                                             prefWidth="112.0" sortable="false"/>
                                <TableColumn fx:id="colCantidad" text="Cant."
                                             prefWidth="38.0" sortable="false"
                                             styleClass="columna-numero"/>
                                <TableColumn fx:id="colPrecio" text="Precio"
                                             prefWidth="58.0" sortable="false"
                                             styleClass="columna-numero"/>
                                <TableColumn fx:id="colSubtotal" text="Subtotal"
                                             prefWidth="64.0" sortable="false"
                                             styleClass="columna-numero"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox styleClass="campo">
                        <Label text="Total" styleClass="etiqueta"/>
                        <Label fx:id="lblTotal" maxWidth="Infinity"
                               styleClass="total-grande"/>
                    </VBox>
                </VBox>

                <!-- Reimprimir, o Guardar/Cancelar mientras se edita -->
                <StackPane>
                    <Button fx:id="btnReimprimir" text="Reimprimir ticket"
                            onAction="#reimprimirTicket"
                            maxWidth="Infinity"
                            styleClass="boton-secundario"
                            disable="true"/>

                    <HBox fx:id="accionesEdicion" styleClass="acciones-detalle"
                          visible="false">
                        <Button fx:id="btnGuardar" text="Guardar"
                                onAction="#guardarVenta"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                styleClass="boton-principal"/>

                        <Button fx:id="btnCancelar" text="Cancelar"
                                onAction="#cancelarAccion"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                styleClass="boton-secundario"/>
                    </HBox>
                </StackPane>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <!-- BARRA INFERIOR -->
        <HBox styleClass="pie">
            <Label fx:id="lblEstadoFooter" text="0 ventas registradas" styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
