<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Reporte de Inventario (stock). Misma ventana de 900x600 y mismas
     barras que el resto de las pantallas; los filtros van en su propia
     barra debajo de la barra de herramientas. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.EstadisticasStockController">

    <top>
        <VBox>
            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La roca" — Reporte de Inventario'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>

            <!-- BARRA DE HERRAMIENTAS: acción principal a la izquierda,
                 Volver al menú al final, como en las demás pantallas -->
            <HBox styleClass="barra-herramientas">
                <Button fx:id="btnGenerar" text="Generar reporte"
                        onAction="#generarReporte"
                        styleClass="boton-principal"/>

                <Button fx:id="btnImprimir" text="Imprimir"
                        onAction="#imprimir"
                        styleClass="boton-secundario"
                        disable="true"/>

                <Button fx:id="btnExportarPdf" text="Exportar PDF"
                        onAction="#exportarPdf"
                        styleClass="boton-secundario"
                        disable="true"/>

                <Button fx:id="btnExportarExcel" text="Exportar Excel"
                        onAction="#exportarExcel"
                        styleClass="boton-secundario"
                        disable="true"/>

                <Button fx:id="btnVolverMenu" text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFecha" styleClass="fecha"/>
            </HBox>

            <!-- BARRA DE FILTROS -->
            <HBox styleClass="barra-filtros">
                <VBox styleClass="filtro">
                    <Label text="Tipo de reporte" styleClass="etiqueta-filtro"/>
                    <ComboBox fx:id="cmbTipoReporte" prefWidth="150.0"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Categoría" styleClass="etiqueta-filtro"/>
                    <ComboBox fx:id="cmbCategoria" prefWidth="170.0"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Desde" styleClass="etiqueta-filtro"/>
                    <DatePicker fx:id="dpDesde" prefWidth="120.0" promptText="dd/mm/aaaa"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Hasta" styleClass="etiqueta-filtro"/>
                    <DatePicker fx:id="dpHasta" prefWidth="120.0" promptText="dd/mm/aaaa"/>
                </VBox>

                <VBox styleClass="filtro">
                    <Label text="Reordenar" styleClass="etiqueta-filtro"/>
                    <ComboBox fx:id="cmbReordenar" prefWidth="150.0"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <!-- Páginas del reporte, como en la vista previa de impresión -->
        <ScrollPane fx:id="scrollReporte"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="reporte-fondo">
            <VBox fx:id="contenedorPaginas" styleClass="reporte-paginas"/>
        </ScrollPane>
    </center>

    <bottom>
        <!-- BARRA DE ESTADO -->
        <HBox styleClass="pie">
            <Label fx:id="lblEstado" text="Genera el reporte para ver el inventario."
                   styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
