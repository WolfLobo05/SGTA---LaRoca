<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.DevolucionProveedorController">

    <top>
        <VBox>

            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">

                <Label text='Sistema abarrotes "La Roca" — Gestión de Devoluciones a Proveedores'
                       styleClass="titulo"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>

            </HBox>

            <!-- BARRA DE HERRAMIENTAS -->
            <HBox styleClass="barra-herramientas">

                <Button fx:id="btnNuevo"
                        text="Nueva devolución"
                        onAction="#nuevaDevolucion"
                        styleClass="boton-principal"/>

                <Button fx:id="btnEditar"
                        text="Editar"
                        styleClass="boton-secundario"
                        disable="true"/>

                <Button fx:id="btnEliminar"
                        text="Cancelar devolución"
                        onAction="#eliminarDevolucion"
                        styleClass="boton-eliminar"
                        disable="true"/>

                <Button fx:id="btnVolverMenu"
                        text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <CheckBox fx:id="chkMostrarCanceladas"
                          text="Mostrar canceladas"
                          onAction="#cambiarMostrarCanceladas"
                          styleClass="check-inactivos"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFechaActual"
                       styleClass="fecha"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <HBox styleClass="contenido" spacing="10.0">

            <!-- TABLA DE DEVOLUCIONES -->
            <TableView fx:id="tableDevoluciones"
                       HBox.hgrow="ALWAYS"
                       styleClass="tabla">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 minWidth="35.0"
                                 prefWidth="40.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colFolio"
                                 text="Folio"
                                 minWidth="65.0"
                                 prefWidth="70.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colFolioCompra"
                                 text="Compra"
                                 minWidth="65.0"
                                 prefWidth="70.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colProveedor"
                                 text="Proveedor"
                                 minWidth="90.0"
                                 prefWidth="115.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colEmpleado"
                                 text="Empleado"
                                 minWidth="85.0"
                                 prefWidth="95.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 minWidth="75.0"
                                 prefWidth="85.0"
                                 sortable="false"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 minWidth="75.0"
                                 prefWidth="85.0"
                                 sortable="false"/>

                </columns>

            </TableView>

            <!-- PANEL DE DETALLE -->
            <VBox styleClass="panel-detalle"
                  minWidth="390.0"
                  prefWidth="390.0"
                  maxWidth="390.0"
                  spacing="8.0">

                <Label text="Detalle de la devolución"
                       styleClass="titulo-detalle"/>

                <VBox styleClass="formulario-compacto"
                      VBox.vgrow="ALWAYS">

                    <!-- FOLIO Y COMPRA -->
                    <HBox spacing="8.0">

                        <VBox styleClass="campo"
                              HBox.hgrow="ALWAYS"
                              prefWidth="150.0">

                            <Label text="Folio"
                                   styleClass="etiqueta"/>

                            <TextField fx:id="txtFolio"
                                       editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>

                        </VBox>

                        <VBox styleClass="campo"
                              HBox.hgrow="ALWAYS"
                              prefWidth="150.0">

                            <Label text="Folio de compra"
                                   styleClass="etiqueta"/>

                            <TextField fx:id="txtFolioCompra"
                                       editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>

                        </VBox>

                    </HBox>

                    <!-- PROVEEDOR -->
                    <VBox styleClass="campo">

                        <Label text="Proveedor"
                               styleClass="etiqueta"/>

                        <TextField fx:id="txtProveedor"
                                   editable="false"
                                   focusTraversable="false"
                                   styleClass="campo-lectura"/>

                    </VBox>

                    <!-- EMPLEADO -->
                    <VBox styleClass="campo">

                        <Label text="Empleado"
                               styleClass="etiqueta"/>

                        <TextField fx:id="txtEmpleado"
                                   editable="false"
                                   focusTraversable="false"
                                   styleClass="campo-lectura"/>

                    </VBox>

                    <!-- FECHA Y ESTADO -->
                    <HBox spacing="8.0">

                        <VBox styleClass="campo"
                              HBox.hgrow="ALWAYS">

                            <Label text="Fecha"
                                   styleClass="etiqueta"/>

                            <TextField fx:id="txtFecha"
                                       editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>

                        </VBox>

                        <VBox styleClass="campo"
                              HBox.hgrow="ALWAYS">

                            <Label text="Estado"
                                   styleClass="etiqueta"/>

                            <TextField fx:id="txtEstado"
                                       editable="false"
                                       focusTraversable="false"
                                       styleClass="campo-lectura"/>

                        </VBox>

                    </HBox>

                    <!-- PRODUCTOS DEVUELTOS -->
                    <VBox styleClass="campo"
                          VBox.vgrow="ALWAYS">

                        <Label text="Productos devueltos"
                               styleClass="etiqueta"/>

                        <TableView fx:id="tableDetalle"
                                   VBox.vgrow="ALWAYS"
                                   minHeight="90.0"
                                   focusTraversable="false"
                                   styleClass="tabla, tabla-chica">

                            <columns>

                                <TableColumn fx:id="colProducto"
                                             text="Producto"
                                             prefWidth="105.0"
                                             sortable="false"/>

                                <TableColumn fx:id="colCantidad"
                                             text="Cant."
                                             prefWidth="42.0"
                                             sortable="false"
                                             styleClass="columna-numero"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio"
                                             prefWidth="60.0"
                                             sortable="false"
                                             styleClass="columna-numero"/>

                                <TableColumn fx:id="colSubtotal"
                                             text="Subtotal"
                                             prefWidth="65.0"
                                             sortable="false"
                                             styleClass="columna-numero"/>

                                <TableColumn fx:id="colMotivo"
                                             text="Motivo"
                                             prefWidth="95.0"
                                             sortable="false"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- TOTAL -->
                    <VBox styleClass="campo">

                        <Label text="Total devuelto"
                               styleClass="etiqueta"/>

                        <Label fx:id="lblTotal"
                               text="0.00"
                               maxWidth="Infinity"
                               styleClass="total-grande"/>

                    </VBox>

                </VBox>

            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox styleClass="pie">

            <Label fx:id="lblEstadoFooter"
                   text="0 devoluciones registradas"
                   styleClass="texto-pie"/>

        </HBox>
    </bottom>

</BorderPane>
