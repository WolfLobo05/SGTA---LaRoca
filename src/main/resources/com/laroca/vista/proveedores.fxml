<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="500.0" prefWidth="850.0"
            stylesheets="@proveedores.css"
            style="-fx-background-color: #ECECEC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.ProveedorController">

   <children>
      <!-- Barra superior -->
      <HBox alignment="CENTER_LEFT" prefHeight="31.0" prefWidth="850.0" style="-fx-background-color: #2A2A2A; -fx-padding: 0 10px;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Sistema abarrotes &quot;La roca&quot; — Gestión de Proveedores" textFill="#F0F0F0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <!-- Barra de herramientas con botón Volver al Menú -->
      <HBox alignment="CENTER_LEFT" layoutY="31.0" spacing="10.0" style="-fx-background-color: #DCDCDC; -fx-padding: 10;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#nuevoProveedor" style="-fx-background-color: #2F6FA8; -fx-text-fill: white;" text="Nuevo" />
            <Button fx:id="btnEliminar" disable="true" mnemonicParsing="false" onAction="#eliminarProveedor" style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C; -fx-text-fill: #A83A3A;" text="Eliminar" />
            <Button fx:id="btnVolverMenu" mnemonicParsing="false" onAction="#volverAlMenu" style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C;" text="Volver al Menú" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblFechaActual" text="--/--/----" textFill="#333333" />
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- Tabla de Proveedores con Scroll Horizontal (Todas las columnas) -->
      <TableView fx:id="tableProveedores" layoutX="14.0" layoutY="85.0" prefHeight="375.0" prefWidth="430.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="85.0">
        <columns>
          <TableColumn fx:id="colRfc" prefWidth="110.0" text="RFC" />
          <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
          <TableColumn fx:id="colContacto" prefWidth="120.0" text="Contacto" />
          <TableColumn fx:id="colCorreo" prefWidth="150.0" text="Correo" />
          <TableColumn fx:id="colDireccion" prefWidth="160.0" text="Dirección" />
          <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
        </columns>
      </TableView>

      <!-- Panel lateral de Detalle -->
      <AnchorPane layoutX="460.0" layoutY="85.0" prefHeight="375.0" prefWidth="375.0" style="-fx-background-color: #F5F5F5; -fx-border-color: #B5B5B5;" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="85.0">
         <children>
            <Label layoutX="15.0" layoutY="12.0" text="Detalle" textFill="#5C5C5C">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            
            <Label layoutX="15.0" layoutY="35.0" text="RFC" textFill="#5C5C5C" />
            <TextField fx:id="txtRfc" layoutX="15.0" layoutY="52.0" prefHeight="26.0" prefWidth="345.0" promptText="ABC123456789" />

            <Label layoutX="15.0" layoutY="83.0" text="Nombre" textFill="#5C5C5C" />
            <TextField fx:id="txtNombre" layoutX="15.0" layoutY="100.0" prefHeight="26.0" prefWidth="345.0" promptText="Distribuidora La Roca" />

            <Label layoutX="15.0" layoutY="131.0" text="Contacto" textFill="#5C5C5C" />
            <TextField fx:id="txtContacto" layoutX="15.0" layoutY="148.0" prefHeight="26.0" prefWidth="345.0" promptText="Juan Pérez" />

            <Label layoutX="15.0" layoutY="179.0" text="Correo" textFill="#5C5C5C" />
            <TextField fx:id="txtCorreo" layoutX="15.0" layoutY="196.0" prefHeight="26.0" prefWidth="345.0" promptText="contacto@laroca.com" />

            <Label layoutX="15.0" layoutY="227.0" text="Dirección" textFill="#5C5C5C" />
            <TextField fx:id="txtDireccion" layoutX="15.0" layoutY="244.0" prefHeight="26.0" prefWidth="345.0" promptText="Av. Principal #123" />

            <Label layoutX="15.0" layoutY="275.0" text="Teléfono" textFill="#5C5C5C" />
            <TextField fx:id="txtTelefono" layoutX="15.0" layoutY="292.0" prefHeight="26.0" prefWidth="345.0" promptText="8441234567" />

            <!-- Botones Guardar y Cancelar -->
            <Button fx:id="btnGuardar" layoutX="15.0" layoutY="332.0" mnemonicParsing="false" onAction="#guardarProveedor" prefHeight="30.0" prefWidth="165.0" style="-fx-background-color: #2F6FA8; -fx-text-fill: white;" text="Guardar" />
            <Button fx:id="btnCancelar" layoutX="195.0" layoutY="332.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="30.0" prefWidth="165.0" style="-fx-background-color: #F5F5F5; -fx-border-color: #8C8C8C;" text="Cancelar" />
         </children>
      </AnchorPane>

      <!-- Pie de página -->
      <HBox alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="850.0" style="-fx-background-color: #DCDCDC; -fx-border-color: #B5B5B5 transparent transparent transparent; -fx-padding: 0 10px;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Label fx:id="lblEstadoFooter" text="Gestión de proveedores activa" textFill="#5C5C5C">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>