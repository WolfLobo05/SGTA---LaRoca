<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla CRUD estándar: 900x600, mismo diseño en los 7 módulos. -->
<BorderPane prefWidth="900.0" prefHeight="600.0"
            minWidth="900.0" minHeight="600.0"
            maxWidth="900.0" maxHeight="600.0"
            styleClass="ventana"
            stylesheets="@laroca.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laroca.controlador.ProveedorController">

    <top>
        <VBox>
            <!-- BARRA DE TÍTULO -->
            <HBox styleClass="barra-titulo">
                <Label text='Sistema abarrotes "La Roca" — Gestión de Proveedores'
                       styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="botones-ventana">
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                    <Region styleClass="boton-ventana"/>
                </HBox>
            </HBox>

            <!-- BARRA DE HERRAMIENTAS -->
            <HBox styleClass="barra-herramientas">
                <Button fx:id="btnNuevo" text="Nuevo"
                        onAction="#nuevoProveedor"
                        styleClass="boton-principal"/>

                <Button fx:id="btnEliminar" text="Eliminar"
                        onAction="#eliminarProveedor"
                        styleClass="boton-eliminar"
                        disable="true"/>

                <Button fx:id="btnVolverMenu" text="Volver al menú"
                        onAction="#volverAlMenu"
                        styleClass="boton-secundario"/>

                <CheckBox fx:id="chkMostrarInactivos"
                          text="Mostrar inactivos"
                          onAction="#cambiarMostrarInactivos"
                          styleClass="check-inactivos"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFechaActual" styleClass="fecha"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox styleClass="contenido">
            <!-- TABLA: una columna por campo del Detalle, Estado al final.
                 Si no caben, la tabla se desplaza en horizontal. -->
            <TableView fx:id="tableProveedores"
                       HBox.hgrow="ALWAYS"
                       styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colRfc" text="RFC"
                                 minWidth="100.0" prefWidth="110.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre"
                                 minWidth="110.0" prefWidth="150.0"/>
                    <TableColumn fx:id="colContacto" text="Contacto"
                                 minWidth="90.0" prefWidth="110.0"/>
                    <TableColumn fx:id="colCorreo" text="Correo"
                                 minWidth="120.0" prefWidth="170.0"/>
                    <TableColumn fx:id="colDireccion" text="Dirección"
                                 minWidth="120.0" prefWidth="160.0"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono"
                                 minWidth="90.0" prefWidth="95.0"/>
                    <TableColumn fx:id="colEstado" text="Estado"
                                 minWidth="70.0" prefWidth="80.0"/>
                </columns>
            </TableView>

            <!-- PANEL DE DETALLE: mismo tamaño en todas las pantallas -->
            <VBox styleClass="panel-detalle"
                  minWidth="320.0" prefWidth="320.0" maxWidth="320.0">

                <Label text="Detalle" styleClass="titulo-detalle"/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS"
                            styleClass="scroll-detalle">
                    <VBox styleClass="formulario">
                        <VBox styleClass="campo">
                            <Label text="RFC" styleClass="etiqueta"/>
                            <TextField fx:id="txtRfc" maxWidth="Infinity"
                                       promptText="ABC123456789"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Nombre" styleClass="etiqueta"/>
                            <TextField fx:id="txtNombre" maxWidth="Infinity"
                                       promptText="Distribuidora La Roca"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Contacto" styleClass="etiqueta"/>
                            <TextField fx:id="txtContacto" maxWidth="Infinity"
                                       promptText="Juan Pérez"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Correo" styleClass="etiqueta"/>
                            <TextField fx:id="txtCorreo" maxWidth="Infinity"
                                       promptText="contacto@laroca.com"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Dirección" styleClass="etiqueta"/>
                            <TextField fx:id="txtDireccion" maxWidth="Infinity"
                                       promptText="Av. Principal #123"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Teléfono" styleClass="etiqueta"/>
                            <TextField fx:id="txtTelefono" maxWidth="Infinity"
                                       promptText="8441234567"/>
                        </VBox>
                        <VBox styleClass="campo">
                            <Label text="Estado" styleClass="etiqueta"/>
                            <!-- El estado solo se muestra; no se edita -->
                            <TextField fx:id="txtEstado" maxWidth="Infinity"
                                       editable="false" disable="true"
                                       focusTraversable="false"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- Fuera del desplazamiento: siempre visibles -->
                <HBox styleClass="acciones-detalle">
                    <Button fx:id="btnGuardar" text="Guardar"
                            onAction="#guardarProveedor"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="boton-principal"
                            disable="true"/>

                    <Button fx:id="btnCancelar" text="Cancelar"
                            onAction="#limpiarFormulario"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="boton-secundario"
                            disable="true"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <!-- BARRA INFERIOR -->
        <HBox styleClass="pie">
            <Label fx:id="lblEstadoFooter" text="0 proveedores activos" styleClass="texto-pie"/>
        </HBox>
    </bottom>

</BorderPane>
